# Dependencies
*node_modules/*

# Build output
dist/
docs/
From*.md
backend/target/

# Secrets and local environment (commit example.env instead)
.env
*.env
!example.env
!backend/example.env
secrets.env
backend/secrets.env
# Ship only the vetted example.env template, not other env variants
*.env.example

# Local tooling / editor state
!.vscode/
!.vs/
!.idea/
.*/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# Reference copy of the host site's own source — not ours to redistribute
source-code-wall/

# Large landing video assets — served from the deploy, not git
landing/assets/*.mp4

# Stray Rust backups
*.rs.bak

# Generated standalone API docs (reproduce with: bun run docs)
landing/api-docs/redoc-static.html

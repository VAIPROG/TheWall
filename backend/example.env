# ==========================================================================
# The Wall Dev — backend environment file
# Copy to `.env` and fill in real values.  Boot fails fast if a *required*
# variable is missing; every *optional* one degrades gracefully (the
# matching feature just won't be wired up).
#
# Custom location:
#   Set THE_WALL_DEV_ENV_FILE=/absolute/path/to/this/file in the actual
#   process environment (systemd Environment=, shell export, etc.) and the
#   backend will load that file at boot, OVERRIDING anything that was
#   already in the environment. Useful for keeping secrets in
#   /etc/the-wall/secrets.env without inlining them in the unit file.
#   If THE_WALL_DEV_ENV_FILE is missing, the default `.env` in the working
#   directory is loaded *without* override.
# ==========================================================================

# ---- required -------------------------------------------------------------
# Postgres connection string. The migration runner creates schema on first boot.
DATABASE_URL=postgres://walldev:walldev@localhost:5432/walldev

# Symmetric key for our own JWTs (Wall sessions + VAI accounts).
# Use a long random value in production: `openssl rand -base64 48`.
JWT_SECRET=change-me-to-something-very-long

# ---- optional: server tunables -------------------------------------------
PORT=3080
SITE_URL=https://filianislost.com
RUST_LOG=info

# Hard cap is 4096 across the board; values above are clamped down.
LIMIT_MESSAGE_CHARS=4000
LIMIT_BIO_CHARS=500
LIMIT_SOCIAL_LABEL=40
LIMIT_SOCIAL_COUNT=12

# Period (seconds) of the snapshot/signals worker. Min 60.
SNAPSHOT_INTERVAL_SECS=300

# Where the support inbox lives (shown to users in the email-by-support flow).
SUPPORT_EMAIL=vadim+the_wall@vai-rice.space

# ==========================================================================
# Telegram — OIDC login (oauth.telegram.org) + Bot API for snapshot delivery
# ==========================================================================
# Three distinct values from @BotFather:
#   /mybots → choose bot → Bot Settings → Web Login:
#     Allowed URLs:
#       https://the-wall.vai-rice.space/vai-auth/
#       https://the-wall.vai-rice.space/
#     CLIENT_ID + CLIENT_SECRET are displayed there.
# The Bot API token is the one you got when running /newbot — different value!

TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Cosmetic hint shown in the UI ("Sign in with @YourBot").
TELEGRAM_BOT_USERNAME=

# ---- snapshot delivery (Telegram side) ----------------------------------
# DM target (your personal user id, e.g. 2006932399). The bot must have been
# /start-ed by this user at least once or it cannot DM them.
TELEGRAM_NOTIFY_USER_ID=
# Channel id (numeric -100… form, e.g. -1003934171210). The bot must be a
# member with post-message permission.
TELEGRAM_NOTIFY_CHANNEL_ID=
# Public username of the channel without the @, used only for building the
# public message URL `https://t.me/<USERNAME>/<msg_id>`.
TELEGRAM_NOTIFY_CHANNEL_USERNAME=theWALLdev

# ==========================================================================
# Discord — OAuth2 for login + bot for snapshot DMs
# ==========================================================================
# Discord Developer Portal → application:
#   OAuth2 → Redirects: same two URLs as Telegram allowed list.
#   CLIENT_ID + CLIENT_SECRET appear under OAuth2 → General.
#   Bot → reset token to obtain DISCORD_BOT_TOKEN.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Where OAuth callbacks land. Default is the static landing page.
DISCORD_REDIRECT_URI=https://the-wall.vai-rice.space/vai-auth/

# Snapshot DM recipient (your Discord user id, e.g. 898576149393846273). The
# bot needs to share at least one guild with the recipient OR the recipient
# must DM the bot first.
DISCORD_NOTIFY_USER_ID=

# ==========================================================================
# Deployment niceties (optional)
# ==========================================================================
# NOTE: `built_at` is baked into the binary at `cargo build` time by build.rs.
#       `deployed_at` is the boot moment — derived from `started_at`.
#       Neither is read from env any more, so there's nothing to set here.
EXTENSION_VERSION=

# --- Admin bot + notification policy (migration 018+) -----------------------
# Telegram user ids (comma-separated) allowed to run admin bot commands
# (/help /status /snapshot /logs /regions /user_count). Also seeded into the
# bot_admins table on boot.
#TELEGRAM_ADMIN_IDS=123456789
# Discord parity registry — stored now, command transport lands later.
#DISCORD_ADMIN_IDS=987654321098765432
# Send periodic snapshot albums to TELEGRAM_NOTIFY_USER_ID as a DM. Default
# off — the channel is the broadcast target; use the bot's /snapshot instead.
#TELEGRAM_SNAPSHOT_DM=off
# Discord interactions (admin slash commands): application id + Ed25519
# public key from the developer portal. Set the portal's Interactions
# Endpoint URL to https://<backend>/api/v2/discord/interactions.
#DISCORD_APPLICATION_ID=000000000000000000
#DISCORD_PUBLIC_KEY=hex_ed25519_public_key

# ==========================================================================
# Server identity + first-owner seeding
# ==========================================================================
# Public owner name/contact shown in /api/v3/meta and the landing footer.
WALL_OWNER_NAME=The Wall Dev
WALL_OWNER_CONTACT=vadim+the_wall@vai-rice.space
# Optional link to the owner's page (e.g. Discord support server or personal site).
#WALL_OWNER_LINK=https://the-wall.vai-rice.space/support

# Initial owner account created automatically when the database has NO users.
# Format: JSON object with username, external_id, source, role, global_role.
# Once any user exists, set this only if you want a manual warning with SQL commands.
# Example for a filianislost site user with external id 12345:
# WALL_OWNER_SEED={"username":"admin","external_id":"12345","source":"filianislost","role":"admin","global_role":"owner"}
WALL_OWNER_SEED=

# ==========================================================================
# Maintenance mode
# ==========================================================================
# When true, /api/v3/health returns 503 and /api/v3/meta reports maintenance.
#WALL_MAINTENANCE_MODE=false
# Reason shown to clients.
#WALL_MAINTENANCE_REASON=scheduled maintenance
# Estimated duration in minutes, used to compute maintenance end time.
#WALL_MAINTENANCE_DURATION_MINUTES=30